PORT=5000

# --- Sarvam AI (response generation) ---
# Get your API key from https://www.sarvam.ai/ (free tier available)
SARVAM_API_KEY=sk_zvat2z0w_spGXl7RZUgCk5X3LuiW5PLbu
SARVAM_MODEL=sarvam-m
SARVAM_CHAT_ENDPOINT=https://api.sarvam.ai/v1/chat/completions
SARVAM_AUTH_HEADER=api-subscription-key

# --- Python runtime ---
PYTHON_BIN=python3
# Pin Python (pipeline.py / fc_model.py) to GPU 2 or 3 — never touch GPU 0 or 1
CUDA_VISIBLE_DEVICES=2,3

# --- Function-calling model (Phase 3) ---
# Base Qwen3-0.6B from HuggingFace Hub (auto-downloads ~1.5 GB)
FC_MODEL_PATH=
FC_MODEL_ID=Qwen/Qwen3-0.6B
ENABLE_FC_MODEL=1

# --- Context-Aware RAG ---
ENABLE_SEMANTIC_RAG=0
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Timeouts & Rate Limiting ---
AI_PIPELINE_TIMEOUT_MS=120000
AI_SARVAM_TIMEOUT_MS=60000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
