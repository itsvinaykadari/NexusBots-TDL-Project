# Nexus Bots server environment template
# Copy to server/.env and fill in real values

# --- Sarvam AI (response generation) ---
SARVAM_API_KEY=
SARVAM_CHAT_ENDPOINT=https://api.sarvam.ai/v1/chat/completions
SARVAM_MODEL=sarvam-m
SARVAM_TIMEOUT_SEC=25
# Which auth header to send: api-subscription-key | Authorization | x-api-key | api-key
SARVAM_AUTH_HEADER=api-subscription-key

# --- Function-calling model (optional) ---
# Set ENABLE_FC_MODEL=1 to load a local/HF fine-tuned model (SmolLM2/Qwen2 QLoRA merged).
# Without it, pipeline.py falls back to the deterministic heuristic router.
ENABLE_FC_MODEL=0
FC_MODEL_PATH=
FC_MODEL_ID=

# --- Context-Aware RAG (optional) ---
# Set ENABLE_SEMANTIC_RAG=1 to use sentence-transformers + FAISS re-ranking.
# Requires pip install -r server/ai/requirements.txt.
ENABLE_SEMANTIC_RAG=0
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Python/runtime ---
PYTHON_BIN=python3
# Pin GPU: pipeline.py and fc_model.py will only see these GPU IDs (avoids GPU 0/1)
CUDA_VISIBLE_DEVICES=2,3
AI_PIPELINE_TIMEOUT_MS=120000
AI_SARVAM_TIMEOUT_MS=60000

# --- Rate limiting for /api/ai/chat ---
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# --- Database ---
NEXUSBOTS_DB_PATH=
